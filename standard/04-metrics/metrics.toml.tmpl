schema_version = 2

# ─────────────────────────────────────────────────────────────────────────
# 这个项目的指标定义。**这份文件是正本**,界面上的指标卡、健康灯全从它推导。
#
# 三层,从上到下:北极星(1 个,必填)→ 滞后指标(≤3)→ 引领指标(≤3)。
# 活推动引领指标,引领指标带动滞后指标,滞后指标逼近北极星。
#
# 完整设计见 docs/v4-prototype/design.md 第 10 章「指标采集与读数」。
# 这里只写「怎么填」,字段的权威定义在那一章,两边不要各写一遍。
# ─────────────────────────────────────────────────────────────────────────
#
# ## 每条指标怎么填
#
#   name    这条指标叫什么(给人看的一句话)
#   def     口径:到底数的是什么、不数什么。写清楚,别指望以后还记得
#   target  目标门槛,如 `≥5` `≤24h` `≥80%`。留空 = 还没定目标,界面显示「目标未设」
#   collect 这个数怎么来。**只有两种**,见下
#
# ## collect 只有两种,没有第三种
#
#   1. 脚本   collect = { kind = "script", run = [...], retro = true|false }
#   2. 手填   collect = { kind = "manual" }
#
# 连 git 、连 GitHub、连 codehub、连内网系统、读一个本地文件 —— 全是脚本自己的事。
# buddy 不认识这些系统,它只会「起进程、传时间窗、读标准输出的 JSON」。
#
# ## retro:这一条是整份文件里最重要的字段
#
# 它回答一个问题:**今天能采到这个数,那么「上周三那天的值」现在还能算出来吗?**
#
#   retro = true   能。buddy 一个字都不存,要看几周就现算几个窗口 —— 新接入的项目
#                  第一天就有完整四周走势,不用先攒。
#   retro = false  不能,过了那一刻就没了。这一类必须把每次读数追加进
#                  `.bw/metrics/readings.jsonl`。**这条落地路径还没接上**,
#                  今天填 false 的指标界面上会如实说「不可回溯的读数还没接」。
#
# **判 retro = false 之前,先真的去找一遍有没有带时间戳的接口。** 判错的代价很实:
# 一条本来能画出四周走势的指标,会被画成只有一个孤点。真实反例 —— GitHub 的 star
# 数看起来只有当前值,但 stargazers 接口带一个特殊 Accept 头就返回每个 star 的时刻,
# 所以它其实是 retro = true(现成脚本见 `.bw/scripts/github-stars.py`)。
#
# ## 脚本协议(buddy 和脚本之间唯一的约定)
#
#   run     argv 数组,第一项是可执行文件,其余是参数。**不走 shell**,所以不要写
#           管道、重定向、`&&`;要用就在脚本里面写。路径相对仓根。
#           写成数组而不是一行命令,是为了在 Windows 上也能明确指定解释器:
#           `["python", ".bw/scripts/x.py"]` 和 `["python3", ...]` 是两回事。
#
#   buddy 起脚本时追加的参数:
#     retro = true   --since YYYY-MM-DD --until YYYY-MM-DD --granularity week
#                    (左闭右开;**窗口由 buddy 给,不是脚本自己决定** —— 面板要
#                     几周就传几周,采多少和画多少永远一致)
#     retro = false  不传窗口,只问「现在是多少」
#
#   脚本要往标准输出打**一个 JSON 对象**,不是 JSON 就算这次采集失败:
#     retro = true   {"points": [{"week": "2026-W34", "value": 12}, ...]}
#     retro = false  {"value": 12}
#
#   value 可以是数,也可以是给人看的字符串(`"87%"` `"3.2h"`)——**原样保留**,
#   要画走势时才解析,解析不出来的点跳过、不画、不猜。
#
#   失败一律如实:非零退出、超时、输出不是 JSON、缺字段 —— 都记这条指标这次
#   「没采到」,**绝不写一个 0 进去**。0 是一个真实的数值,「没采到」不是。
#
# ## 脚本铺一次就归项目
#
# buddy 铺进 `.bw/scripts/` 的几份是通用起手式,**之后 buddy 再也不覆盖它们**。
# 改窗口、改口径、换数据源,直接改脚本 —— 脚本本身就是「这个数怎么来的」的文档。
#
# ─────────────────────────────────────────────────────────────────────────

[north_star]
name = "(还没填)三个月长成什么样的可度量说法"
def = "(还没填)数的到底是什么、不数什么"
target = ""
# 先想清楚这个数怎么来。想不出脚本就先手填,但每周的运作活①都会再问你一次
# 「这个数能不能写成脚本」—— 目标是让手填越来越少。
collect = { kind = "manual" }

# ── 滞后指标(≤3):结果量,月/周更新 ───────────────────────────────
# 早期定不出来是正常的,允许一条都没有,界面如实显示灰。
# 例:
# [[lagging]]
# name = "接入团队数"
# def = "真实跑通过一条流水线的团队,去重后计数;试用未跑通的不算"
# target = "≥3"
# collect = { kind = "manual" }

# ── 引领指标(≤3):本周可控的先行量,直接由活推动 ──────────────────
# 例(下面三条对应 buddy 铺的三份现成脚本,可以直接放开用):
#
# [[leading]]
# name = "本周合入的 PR 数"
# def = "远端上 merged 时刻落在这一周的 PR 数;本机的合并提交不算(口径不同)"
# target = "≥5"
# collect = { kind = "script", run = ["python3", ".bw/scripts/github-merged-prs.py"], retro = true }
#
# [[leading]]
# name = "每周提交数"
# def = "当前分支上提交时刻落在这一周的提交数;不带 --all(否则一次 fetch 就能把数字刷上去)"
# target = "≥20"
# collect = { kind = "script", run = ["python3", ".bw/scripts/git-commits.py"], retro = true }
#
# [[leading]]
# name = "GitHub star 数"
# def = "仓的 star 总数;按 starred_at 倒推,所以每周末的存量都算得出来"
# target = ""
# collect = { kind = "script", run = ["python3", ".bw/scripts/github-stars.py"], retro = true }
